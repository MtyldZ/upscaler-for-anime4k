{
  "manifest_version": 3,
  "name": "Anime4K Local",
  "version": "1.2.0",
  "description": "Real-time Anime4K upscaling for HTML5 video. Runs locally on your GPU via WebGPU.",
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Anime4K",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "toggle": {
      "suggested_key": {
        "default": "Alt+U"
      },
      "description": "Toggle Anime4K"
    },
    "next-mode": {
      "suggested_key": {
        "default": "Alt+Shift+U"
      },
      "description": "Next Anime4K mode"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "modes.js",
        "content.js"
      ],
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
